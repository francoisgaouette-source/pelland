rules_version = '2';
// Règles de sécurité Firestore — Le 19e (Fanion).
// Principe : chaque membre ne voit et ne modifie que les données de SON groupe.
// - Un membre = un compte « courriel / mot de passe » relié à son joueur par auth/{uid} = { playerId, groupId }.
//   Ce lien est vérifié : le cellulaire confirmé du compte est celui du joueur (comptes actuels),
//   ou le courriel du compte est celui inscrit sur la fiche du joueur (anciens comptes, fondateur d'un groupe).
// - La collection players ne contient plus que les noms et les groupes (lisibles pour l'écran de connexion) ; aucun numéro.
// - Les terrains sont communs à tous les groupes.
service cloud.firestore {
  match /databases/{database}/documents {

    function membre() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['password', 'phone'];
    }
    function courriel() {
      return request.auth.token.get('email', '');
    }
    // Le cellulaire confirmé du compte (par code texto) est celui inscrit pour ce joueur
    function monNumero() {
      return request.auth.token.get('phone_number', '');
    }
    function bonNumero(playerId) {
      return monNumero() != ''
        && exists(/databases/$(database)/documents/phones/$(playerId))
        && (get(/databases/$(database)/documents/phones/$(playerId)).data.get('e164', '') == monNumero()
            || ('+1' + get(/databases/$(database)/documents/phones/$(playerId)).data.phone) == monNumero());
    }
    function lien() {
      return get(/databases/$(database)/documents/auth/$(request.auth.uid)).data;
    }
    // Le membre connecté fait partie du groupe g
    function dansGroupe(g) {
      return membre() && exists(/databases/$(database)/documents/auth/$(request.auth.uid)) && lien().groupId == g;
    }
    function joueur(id) {
      return get(/databases/$(database)/documents/players/$(id)).data;
    }
    function groupeDe(data) {
      return data.get('groupId', 'pelland');
    }

    // ---------- Lien compte → joueur → groupe ----------
    match /auth/{uid} {
      allow read: if membre() && request.auth.uid == uid;
      allow create, update: if membre() && request.auth.uid == uid
        && ((courriel() != '' && joueur(request.resource.data.playerId).get('authEmail', '') == courriel())
            || bonNumero(request.resource.data.playerId))
        && request.resource.data.groupId == groupeDe(joueur(request.resource.data.playerId));
      allow delete: if false;
    }

    // ---------- Joueurs et documents du groupe ----------
    match /players/{id} {
      allow read: if true;

      // Fiche d'un joueur (identifiant sans « _ »)
      allow create: if membre() && !id.matches('_.*') && (
          dansGroupe(request.resource.data.groupId)
          // fondateur d'un nouveau groupe : c'est lui le propriétaire et la fiche porte son courriel
          || (get(/databases/$(database)/documents/players/$('_groupe_' + request.resource.data.groupId)).data.owner == id
              && courriel() != '' && request.resource.data.authEmail == courriel()));
      allow update: if membre() && !id.matches('_.*') && (
          (dansGroupe(groupeDe(resource.data)) && groupeDe(request.resource.data) == groupeDe(resource.data))
          // premier membre d'un ancien groupe : il inscrit son propre courriel sur sa fiche
          || (resource.data.get('authEmail', '') == '' && courriel() != '' && request.resource.data.authEmail == courriel()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail', 'phoneHint'])));
      allow delete: if membre() && !id.matches('_.*') && dansGroupe(groupeDe(resource.data));

      // Groupe : _groupe_<g>
      // Le forfait (plan, paidUntil) est donné par Fanion après le paiement : jamais modifiable depuis l'app
      allow create: if membre() && id.matches('_groupe_.+') && request.resource.data.id == id.split('_groupe_')[1]
        && !request.resource.data.keys().hasAny(['plan', 'paidUntil']);
      allow update: if membre() && id.matches('_groupe_.+') && dansGroupe(id.split('_groupe_')[1])
        && request.resource.data.id == resource.data.id
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'paidUntil'])
        // propriétaire et organisateur : seul le propriétaire les change (ou un membre réclame un groupe sans propriétaire)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'organizers'])
            || resource.data.get('owner', '') == ''
            || lien().playerId == resource.data.owner);

      // Anciens documents privés (_quatuors, _jeux_, _offre_, _demandes_jeux) : déplacés dans groupdata, offres et requests.
      // On permet seulement de les effacer (migration faite par l'app) ; plus aucune création.
      allow delete: if id == '_quatuors' && dansGroupe('pelland');
      allow delete: if id.matches('_quatuors_.+') && dansGroupe(id.split('_quatuors_')[1]);
      allow delete: if id.matches('_jeux_.+') && dansGroupe(id.split('_jeux_')[1]);
      allow delete: if id.matches('_offre_.+') && dansGroupe(groupeDe(resource.data));
      allow delete: if id == '_demandes_jeux' && membre();
    }

    // ---------- Données privées du groupe : quatuors et jeux maison ----------
    match /groupdata/{g} {
      allow read: if dansGroupe(g);
      allow create, update: if dansGroupe(g) && request.resource.data.groupId == g;
      allow delete: if false;
    }

    // ---------- Dates offertes et disponibilités ----------
    match /offres/{id} {
      allow get: if dansGroupe(resource.data.groupId);
      allow list: if dansGroupe(resource.data.groupId);
      allow create: if dansGroupe(request.resource.data.groupId);
      allow update: if dansGroupe(resource.data.groupId) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if dansGroupe(resource.data.groupId);
    }

    // ---------- Demandes d'ajout de jeux : envoyées par les membres, lues seulement dans la console ----------
    match /requests/{id} {
      allow create: if membre();
      allow read, update, delete: if false;
    }

    // ---------- Numéros de téléphone complets : seulement le groupe du joueur ----------
    match /phones/{playerId} {
      // lecture d'un numéro ou de la liste du groupe (requête « groupId == mon groupe »),
      // ou de ses propres inscriptions dans tous les groupes (requête « e164 == mon cellulaire »)
      allow get, list: if dansGroupe(resource.data.groupId)
        || (membre() && monNumero() != '' && resource.data.get('e164', '') == monNumero())
        || (membre() && monNumero() != '' && resource.data.phone == monNumero().replace('^[+]1', ''));
      allow create, update: if dansGroupe(request.resource.data.groupId)
        && groupeDe(joueur(playerId)) == request.resource.data.groupId
        && request.resource.data.get('e164', '+1' + request.resource.data.phone) == '+1' + request.resource.data.phone;
      allow delete: if dansGroupe(resource.data.groupId);
    }

    // ---------- Parties ----------
    match /games/{gameId} {
      // une partie (lien ou code) ; les anciennes parties sans groupe appartiennent à la gang à Pelland
      allow get: if dansGroupe(resource.data.get('groupId', 'pelland'));
      // la liste des parties du groupe (requête « groupId == mon groupe »)
      allow list: if dansGroupe(resource.data.groupId);
      allow create: if dansGroupe(request.resource.data.groupId) && request.resource.data.ownerUid == request.auth.uid;
      // le responsable modifie sa partie ; un autre membre du groupe peut la reprendre ; le groupe ne change jamais
      allow update: if dansGroupe(resource.data.get('groupId', 'pelland'))
        && request.resource.data.groupId == resource.data.get('groupId', 'pelland')
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.ownerUid == ''
            || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if dansGroupe(resource.data.get('groupId', 'pelland')) && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Compétitions (membre-membre) : seulement le groupe ----------
    match /comps/{id} {
      allow get, list: if dansGroupe(resource.data.groupId);
      allow create: if dansGroupe(request.resource.data.groupId);
      allow update: if dansGroupe(resource.data.groupId) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if dansGroupe(resource.data.groupId);
    }

    // ---------- Présences à une partie ----------
    match /presence/{gameId} {
      allow read, write: if dansGroupe(get(/databases/$(database)/documents/games/$(gameId)).data.get('groupId', 'pelland'));
    }

    // ---------- Terrains (communs) ----------
    match /courses/{courseId} {
      allow read, create, update: if membre();
      allow delete: if false;
    }
  }
}
